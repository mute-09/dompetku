[Unit]
Description=Cloudflare Tunnel untuk DompetKu (dompetku.labku.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/dompetku.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target